# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# .env.local takes precedence over .env, so it is what points development at the
# local Docker Postgres rather than at production. Both are gitignored.

# Local database from docker-compose.yml. Start it with `npm run db:up`.
DATABASE_URL=postgres://guild:guild@127.0.0.1:55432/guild_website

# Any non-empty string locally. Production uses a real secret.
PAYLOAD_SECRET=local-dev-only-not-a-real-secret

# Guild identity, used to build the Raider.IO request.
GUILD_NAME=Potato Corner
GUILD_REALM=Barthilas
GUILD_REGION=us

# Only needed to exercise the scheduled-sync auth path locally.
CRON_SECRET=
