{
  "name": "guild-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node node_modules/payload/bin.js migrate --use-swc && next build",
    "start": "next start",
    "payload": "node node_modules/payload/bin.js",
    "migrate": "node node_modules/payload/bin.js migrate --use-swc",
    "migrate:create": "node node_modules/payload/bin.js migrate:create --use-swc",
    "migrate:status": "node node_modules/payload/bin.js migrate:status --use-swc",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait && npm run migrate && npm run seed",
    "seed": "node --import @swc-node/register/esm-register scripts/seed-local.mjs",
    "generate:importmap": "node node_modules/payload/bin.js generate:importmap --use-swc",
    "generate:types": "node node_modules/payload/bin.js generate:types --use-swc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.check.json"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.79.1",
    "@payloadcms/next": "^3.79.1",
    "@payloadcms/richtext-lexical": "^3.79.1",
    "framer-motion": "^12.37.0",
    "graphql": "^16.13.1",
    "lucide-react": "^0.577.0",
    "next": "^16.2.0-canary.10",
    "next-themes": "^0.4.6",
    "payload": "^3.79.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
