# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no secrets and is how a fresh clone
# learns to point at the local database instead of production.
!.env.example

# vercel
.vercel

# claude/superpowers
.claude/
.superpowers/

# docs — ignore contents, but keep the agent skill config and the ADRs tracked.
# Git won't descend into an excluded directory, so docs/ itself must stay
# walkable: exclude its children instead, then re-include the two we keep.
# ADRs are the durable record of why decisions were made — they are useless
# to anyone who clones the repo if they only exist on one machine.
docs/*
!docs/agents/
!docs/adr/

# typescript
*.tsbuildinfo
next-env.d.ts
